{
  "name": "omk_ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.21.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openmemorykit/omk_ui.git"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "node tools/typecheck.mjs",
    "test": "vitest run --coverage",
    "build": "node tools/fonts.mjs && vite build",
    "build:preview": "node tools/fonts.mjs && vite build --mode preview",
    "dev:preview": "node tools/fonts.mjs && vite --mode preview",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && node tools/version.mjs"
  },
  "dependencies": {
    "@fontsource/archivo-narrow": "5.3.0",
    "@fontsource/sofia-sans-semi-condensed": "5.3.0",
    "@openmemorykit/core": "github:openmemorykit/omk-core#v0.1.0",
    "@openmemorykit/ui": "github:openmemorykit/omk-ui-sdk#v0.1.0",
    "valibot": "1.4.2",
    "vue": "3.5.46"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-vue": "6.0.11",
    "@vitest/coverage-v8": "5.1.1",
    "@vue/test-utils": "2.6.0",
    "eslint": "10.15.0",
    "eslint-plugin-compat": "7.0.2",
    "eslint-plugin-vue": "10.12.1",
    "happy-dom": "21.0.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  }
}
